# Copy this file to ".env" and fill in real values. Never commit ".env".

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartfind"

# Secret used to sign login tokens (long random string, at least 16 characters)
JWT_SECRET="change-me-to-a-long-random-string"
# How long a login token is valid (e.g. 1h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# The React client address. Only this origin may call the API (comma-separate several).
CLIENT_ORIGIN="http://localhost:5173"

# The admin account created by the seed script
ADMIN_EMAIL="admin@smartfind.local"
ADMIN_PASSWORD="change-me-admin-password"

# Server port
PORT=3000

# Optional: seed sample found items + a demo user (default: true). Set to "false" in production.
SEED_SAMPLE_DATA="true"
