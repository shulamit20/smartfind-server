# Copy to ".env.test" for running tests. It MUST point to a separate database whose name contains "test" –
# the tests delete all data in it.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartfind_test"
JWT_SECRET="test-secret-at-least-16-chars"
JWT_EXPIRES_IN="1h"
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="test"
